# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy to .env and fill in real values before starting the app.
# Variables map to fields in app/core/config.py (pydantic-settings, UPPER_SNAKE),
# except the POSTGRES_* group, which is consumed by docker-compose.yml.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM provider for trade-rationale generation (REQUIRED) ───────────────────
# One of: openai | anthropic | ollama | openrouter | lm_studio
RESEARCH_LLM_PROVIDER=ollama
# Model name; empty = provider default (e.g. gpt-4o-mini, llama3.1)
RESEARCH_LLM_MODEL=
# Anthropic extended-thinking token budget (0 = disabled; max ~16000)
RESEARCH_LLM_THINKING_BUDGET=0

# ── API keys (set the one matching RESEARCH_LLM_PROVIDER) ─────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# ── Local LLM servers (when provider is ollama / lm_studio) ───────────────────
# Use the host LAN IP (not localhost) when the app runs inside Docker/Podman.
OLLAMA_BASE_URL=http://localhost:11434
LM_STUDIO_BASE_URL=http://localhost:1234/v1

# ── Database ──────────────────────────────────────────────────────────────────
# Default is local SQLite. docker-compose points this at TimescaleDB/Postgres.
DATABASE_URL=sqlite+aiosqlite:///./data/trading.db

# ── PostgreSQL / TimescaleDB (docker-compose service) ────────────────────────
POSTGRES_USER=trading
POSTGRES_PASSWORD=trading
POSTGRES_DB=trading

# ── One-time SQLite → PostgreSQL migration ───────────────────────────────────
MIGRATION_ENABLED=false
SQLITE_SOURCE_URL=sqlite:///./data/trading.db

# ── Finnhub market data (optional) ───────────────────────────────────────────
# When BOTH are set, eligible plain stock tickers use Finnhub instead of Yahoo.
FINNHUB_USER=
FINNHUB_KEY=

# ── Recommendation engine ─────────────────────────────────────────────────────
# Risk stance: conservative | moderate | aggressive
PREFERRED_RISK=moderate

# ── Ticker resolver ───────────────────────────────────────────────────────────
PREFERRED_EXCHANGES=NMS,NYQ,NGM,PCX,BTS,ASE,LSE,GER,PAR,AMS,MIL,TYO,HKG,SHH,SHZ,KSC,TSE,SAO,JSE,NSI,BSE
TICKER_CACHE_MAX_AGE_DAYS=90

# ── Jobs / scheduling ─────────────────────────────────────────────────────────
DAILY_BATCH_HOUR=6
UPDATE_ACTIVE_TRADES_INTERVAL_HOURS=2
ANALYSIS_RUN_INTERVAL_HOURS=2

# ── Feed cache ────────────────────────────────────────────────────────────────
FEED_MAX_AGE_DAYS=30

# ── Debug ─────────────────────────────────────────────────────────────────────
DEBUG=false
